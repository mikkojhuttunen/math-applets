{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinnMath misconception exercise item, upper secondary (lukio)",
  "description": "One lukio exercise item. Items live in lukio/exercises/<TopicID>/<TypeCode>.json inside a wrapper {schema_version, topic, type, items[]}. Copied from ../../schema/item.schema.json (7-9) and adapted as BACKLOG_LUKIO.md section 0 describes: lukio curriculum block, LU- item IDs, L-prefixed topic IDs, extra answer kinds antiderivative, periodic, interval and rational. The letter e is Euler's number, never a variable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "type", "status", "lang", "curriculum", "misconceptions", "prompt", "payload", "solution", "feedback", "provenance"],
  "properties": {
    "schema_version": {"const": "lukio-1.0"},
    "id": {"type": "string", "pattern": "^LU-(L[A-Z]{3}|ALG|NUM|PRO|GEO|FUN|PRB|EXT)-[0-9]{2}-(MC|NE|ES|SO|FS|ME|RP|SC|MA|EST|GI|NL|EX|TF|PH)-[0-9]{3}$"},
    "type": {"enum": ["MC", "NE", "ES", "SO", "FS", "ME", "RP", "SC", "MA", "EST", "GI", "NL", "EX", "TF", "PH"]},
    "status": {"enum": ["draft", "approved", "retired"]},
    "lang": {"enum": ["fi", "en"]},
    "curriculum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lops", "g", "syllabus", "level", "tools"],
      "properties": {
        "lops": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/lopsId"}},
        "g": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/gId"}},
        "syllabus": {"enum": ["MAA", "MAB"]},
        "level": {"enum": ["P", "T", "H", "K"]},
        "tools": {"enum": ["none", "cas"]}
      }
    },
    "misconceptions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/topicId"}},
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 1000},
        "latex": {"type": ["string", "null"]},
        "figure": {"type": ["object", "null"]}
      }
    },
    "payload": {"type": "object"},
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "final"],
      "properties": {
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "final": {"type": "string", "minLength": 1}
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correct"],
      "properties": {
        "correct": {"type": "string", "minLength": 1},
        "generic_wrong": {"type": "string"},
        "wrong_line": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "params", "generated", "verified", "run"],
      "properties": {
        "template": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "params": {"type": "object"},
        "generated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "verified": {"type": "boolean"},
        "run": {"type": "integer", "minimum": 1}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "MC"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/payloadMC"}}}},
    {"if": {"properties": {"type": {"const": "NE"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/payloadNE"}}}},
    {"if": {"properties": {"type": {"const": "ES"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/payloadES"}}}},
    {"if": {"properties": {"type": {"const": "SO"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/payloadSO"}}}},
    {"if": {"properties": {"type": {"const": "FS"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/payloadFS"}}}},
    {"if": {"properties": {"type": {"const": "ME"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/payloadME"}}}},
    {"if": {"properties": {"type": {"const": "RP"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/payloadRP"}}}}
  ],
  "$defs": {
    "topicId": {"type": "string", "pattern": "^(L[A-Z]{3}|ALG|NUM|PRO|GEO|FUN|PRB|EXT)-[0-9]{2}$"},
    "lopsId": {"type": "string", "pattern": "^(MAY1|MAA([2-9]|1[0-2])|MAB[2-9])\\.[0-9]{2}$"},
    "gId": {"type": "string", "pattern": "^G[1-8]$"},
    "nullableTopic": {"anyOf": [{"$ref": "#/$defs/topicId"}, {"type": "null"}]},
    "variable": {"type": "string", "pattern": "^[a-df-z]$"},
    "variables": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/variable"}},
    "samples": {"type": "array", "minItems": 3, "items": {"type": "array", "items": {"type": "number"}}},
    "exact": {"description": "Exact value: a number, or a string such as \"pi/6\", \"−3/2\" or \"sqrt(2)\".", "type": ["number", "string"], "minLength": 1},
    "wrongEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "misconception", "feedback"],
      "properties": {
        "match": {"type": ["string", "number"]},
        "misconception": {"$ref": "#/$defs/nullableTopic"},
        "feedback": {"type": "string", "minLength": 1}
      }
    },
    "answerNumber": {
      "type": "object", "additionalProperties": false, "required": ["kind", "value"],
      "properties": {"kind": {"const": "number"}, "value": {"type": "number"}, "tolerance": {"type": "number", "minimum": 0}, "unit": {"type": "string"}}
    },
    "answerRational": {
      "description": "Exact fraction in lowest terms, e.g. \"-5/12\" or \"7\". Decimal input is not accepted as equal.",
      "type": "object", "additionalProperties": false, "required": ["kind", "value"],
      "properties": {"kind": {"const": "rational"}, "value": {"type": "string", "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"}}
    },
    "answerExpression": {
      "type": "object", "additionalProperties": false, "required": ["kind", "variables", "reference", "samples"],
      "properties": {"kind": {"const": "expression"}, "variables": {"$ref": "#/$defs/variables"}, "reference": {"type": "string", "minLength": 1}, "samples": {"$ref": "#/$defs/samples"}}
    },
    "answerSet": {
      "type": "object", "additionalProperties": false, "required": ["kind", "values"],
      "properties": {"kind": {"const": "set"}, "values": {"type": "array", "minItems": 1, "items": {"type": "number"}}}
    },
    "answerEquation": {
      "type": "object", "additionalProperties": false, "required": ["kind", "reference", "variable", "solutions"],
      "properties": {
        "kind": {"const": "equation"},
        "reference": {"type": "string", "minLength": 1},
        "variable": {"$ref": "#/$defs/variable"},
        "solutions": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "equivalents": {"type": "array", "items": {"type": "string"}}
      }
    },
    "answerAntiderivative": {
      "description": "Any F with F' = integrand is accepted if it contains the constant; checked by differentiating. reference is one antiderivative including the constant, e.g. \"x**3/3 + C\".",
      "type": "object", "additionalProperties": false, "required": ["kind", "variable", "integrand", "reference", "constant", "samples"],
      "properties": {
        "kind": {"const": "antiderivative"},
        "variable": {"$ref": "#/$defs/variable"},
        "integrand": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1},
        "constant": {"enum": ["C", "D", "K"]},
        "samples": {"$ref": "#/$defs/samples"}
      }
    },
    "answerPeriodic": {
      "description": "All solutions of a trigonometric equation: base solutions in [0, period) plus multiples of the period. In degrees the equation's angles are read in degrees.",
      "type": "object", "additionalProperties": false, "required": ["kind", "variable", "reference", "unit", "base", "period"],
      "properties": {
        "kind": {"const": "periodic"},
        "variable": {"$ref": "#/$defs/variable"},
        "reference": {"type": "string", "minLength": 1},
        "unit": {"enum": ["rad", "deg"]},
        "base": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/exact"}},
        "period": {"$ref": "#/$defs/exact"}
      }
    },
    "answerInterval": {
      "description": "Solution set of an inequality as a union of intervals; lo or hi null means -inf or +inf. An empty list means no solutions.",
      "type": "object", "additionalProperties": false, "required": ["kind", "variable", "reference", "intervals"],
      "properties": {
        "kind": {"const": "interval"},
        "variable": {"$ref": "#/$defs/variable"},
        "reference": {"type": "string", "minLength": 1},
        "intervals": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["lo", "hi", "lo_closed", "hi_closed"],
            "properties": {
              "lo": {"anyOf": [{"$ref": "#/$defs/exact"}, {"type": "null"}]},
              "hi": {"anyOf": [{"$ref": "#/$defs/exact"}, {"type": "null"}]},
              "lo_closed": {"type": "boolean"},
              "hi_closed": {"type": "boolean"}
            }
          }
        }
      }
    },
    "payloadMC": {
      "type": "object", "additionalProperties": false, "required": ["options", "correct"],
      "properties": {
        "options": {
          "type": "array", "minItems": 3, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "text", "misconception", "feedback"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-h]$"},
              "text": {"type": "string", "minLength": 1, "maxLength": 200},
              "misconception": {"$ref": "#/$defs/nullableTopic"},
              "feedback": {"type": "string"}
            }
          }
        },
        "correct": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "pattern": "^[a-h]$"}}
      }
    },
    "payloadNE": {
      "type": "object", "additionalProperties": false, "required": ["answer", "wrong"],
      "properties": {
        "answer": {"oneOf": [
          {"$ref": "#/$defs/answerNumber"}, {"$ref": "#/$defs/answerRational"}, {"$ref": "#/$defs/answerExpression"},
          {"$ref": "#/$defs/answerSet"}, {"$ref": "#/$defs/answerAntiderivative"}, {"$ref": "#/$defs/answerPeriodic"},
          {"$ref": "#/$defs/answerInterval"}
        ]},
        "wrong": {"type": "array", "items": {"$ref": "#/$defs/wrongEntry"}},
        "input_hint": {"type": "string"}
      }
    },
    "payloadES": {
      "type": "object", "additionalProperties": false, "required": ["lines", "error_line", "error_type"],
      "properties": {
        "lines": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"type": "string", "minLength": 1}},
        "error_line": {"type": "integer", "minimum": 2},
        "error_type": {"type": "string", "pattern": "^[a-z0-9_]+$"}
      }
    },
    "payloadSO": {
      "type": "object", "additionalProperties": false, "required": ["lines", "accept"],
      "properties": {
        "lines": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"type": "string", "minLength": 1}},
        "accept": {"enum": ["exact", "dependency"]},
        "dependencies": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}}
      }
    },
    "payloadFS": {
      "type": "object", "additionalProperties": false, "required": ["lines", "blank_index", "answer"],
      "properties": {
        "lines": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"type": "string", "minLength": 1}},
        "blank_index": {"type": "integer", "minimum": 1},
        "answer": {"oneOf": [{"$ref": "#/$defs/answerExpression"}, {"$ref": "#/$defs/answerEquation"}]}
      }
    },
    "payloadME": {
      "type": "object", "additionalProperties": false, "required": ["reference", "variables", "samples", "options"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "variables": {"$ref": "#/$defs/variables"},
        "samples": {"$ref": "#/$defs/samples"},
        "options": {
          "type": "array", "minItems": 3, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "text", "equivalent", "misconception"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-h]$"},
              "text": {"type": "string", "minLength": 1, "maxLength": 200},
              "equivalent": {"type": "boolean"},
              "misconception": {"$ref": "#/$defs/nullableTopic"}
            }
          }
        }
      }
    },
    "payloadRP": {
      "type": "object", "additionalProperties": false, "required": ["constraint", "checks"],
      "properties": {
        "constraint": {
          "type": "object", "additionalProperties": false, "required": ["type", "variable", "value"],
          "properties": {"type": {"const": "solution_equals"}, "variable": {"$ref": "#/$defs/variable"}, "value": {"type": "number"}}
        },
        "checks": {
          "type": "object", "additionalProperties": false, "required": ["valid", "invalid"],
          "properties": {
            "valid": {"type": "array", "minItems": 2, "items": {"type": "string"}},
            "invalid": {"type": "array", "minItems": 2, "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
